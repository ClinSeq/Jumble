\name{frankenplot}
\alias{frankenplot}
\title{Generate Frankenplot Genome Report}
\usage{
frankenplot(
  tumor_jumble_csv,
  tumor_cns,
  output_file,
  normal_jumble_csv = NULL,
  normal_cns = NULL,
  tumor_snp_vcf = NULL,
  normal_snp_vcf = NULL,
  somatic_vcf = NULL,
  germline_vcf = NULL,
  tumor_sample_name = NULL,
  normal_sample_name = NULL,
  genome = NULL,
  hrdtable = NULL,
  qc_file = NULL,
  qc_metrics = NULL,
  dpyd_json = NULL,
  dpyd_csv = NULL,
  output_png = NULL
)
}
\arguments{
\item{tumor_jumble_csv}{Path to a tumor Jumble bin-level CSV file.}
\item{tumor_cns}{Path to a tumor segment file in CNS format.}
\item{output_file}{Path to the output HTML report.}
\item{normal_jumble_csv}{Optional path to a normal Jumble bin-level CSV file.}
\item{normal_cns}{Optional path to a normal segment file in CNS format.}
\item{tumor_snp_vcf}{Optional path to a tumor SNP VCF file.}
\item{normal_snp_vcf}{Optional path to a normal SNP VCF file.}
\item{somatic_vcf}{Optional path to a somatic mutation VCF file.}
\item{germline_vcf}{Optional path to a germline mutation VCF file.}
\item{tumor_sample_name}{Optional tumor sample name hint for VCF column selection.}
\item{normal_sample_name}{Optional normal sample name hint for VCF column selection.}
\item{genome}{Genome build, either \code{"hg19"} or \code{"hg38"}. If \code{NULL}, Jumble attempts to infer it from chromosome naming.}
\item{hrdtable}{Optional precomputed GIS/HRD table to display. Frankenplot does not compute GIS internally.}
\item{qc_file}{Optional path to a Jumble QC CSV file.}
\item{qc_metrics}{Optional QC metrics object supplied directly.}
\item{dpyd_json}{Optional path to a DPYD JSON result file.}
\item{dpyd_csv}{Optional path to a DPYD CSV evidence file.}
\item{output_png}{Optional path to the static tumor overview PNG. If \code{NULL}, the PNG path is derived from \code{output_file}. Use \code{NA} or an empty string to disable PNG creation.}
}
\value{
Invisibly returns the path to the generated HTML report.
}
\description{
Creates an interactive HTML genome report from Jumble output files, including genome-wide and per-chromosome copy-number plots and optional SNP, mutation, GIS/HRD, QC, and DPYD overlays. The main tumor overview figure is also written as a static PNG for systems that need a non-interactive preview image.
}
\details{
The function expects output files generated by \code{run_jumble()} or equivalent Jumble-compatible tables. Optional VCF inputs are parsed only when provided. GIS/HRD results are displayed when supplied through \code{hrdtable}; they are not computed by this reporting function. By default, the static PNG path is derived from the HTML output path by replacing \code{.html} or \code{.htm} with \code{.png}.
}
\examples{
args(frankenplot)
}
